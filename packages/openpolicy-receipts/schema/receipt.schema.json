{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Educatian/aiedobservatory/packages/openpolicy-receipts/schema/receipt.schema.json",
  "title": "OpenPolicy Receipt 1.0 Draft",
  "type": "object",
  "required": [
    "receipt_version",
    "receipt_id",
    "generated_at",
    "actor",
    "action",
    "resource",
    "authorization",
    "provenance",
    "inputs",
    "outputs",
    "review",
    "lifecycle",
    "state",
    "signature"
  ],
  "properties": {
    "receipt_version": { "const": "1.0-draft" },
    "receipt_id": { "type": "string", "minLength": 8 },
    "generated_at": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "resource": { "type": "string", "minLength": 1 },
    "authorization": {
      "type": "object",
      "required": ["allowed_actions", "allowed_resources", "network_access", "secrets_access"],
      "properties": {
        "allowed_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "allowed_resources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "network_access": { "type": "boolean" },
        "secrets_access": { "type": "boolean" },
        "delegated_by": { "type": ["string", "null"] },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "provenance": { "type": "object" },
    "inputs": { "type": "array" },
    "outputs": { "type": "array" },
    "review": { "type": "object" },
    "lifecycle": { "type": "array" },
    "state": { "enum": ["active", "retired"] },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "signed_digest_sha256", "value_base64"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "signed_digest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "value_base64": { "type": "string", "minLength": 16 }
      },
      "additionalProperties": false
    }
  }
}
